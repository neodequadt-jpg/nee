#!/usr/bin/env bash
# Unset proxy env for localhost-only communication with OmniRoute
unset HTTP_PROXY HTTPS_PROXY ALL_PROXY http_proxy https_proxy all_proxy
export NO_PROXY="127.0.0.1,localhost,::1"
export no_proxy="127.0.0.1,localhost,::1"
exec "$HOME/NEE/.venv/bin/python" "$HOME/NEE/bin/nee.py" "$@"
